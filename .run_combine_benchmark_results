#!/usr/bin/python3
import json
from pathlib import Path

workspace_dir = Path("/__w/tesseract/tesseract/target_ws")

# Every component writes its results next to its benchmark executables, <build>/<component>/test/benchmarks
result_files = sorted((workspace_dir / "build" / "tesseract").glob("*/test/benchmarks/*_results.json"))
if not result_files:
    raise SystemExit("No benchmark results found under " + str(workspace_dir / "build" / "tesseract"))

all_data = {}
for file in result_files:
    print("Combining " + str(file))
    data = json.loads(file.read_text())
    if not all_data:
        all_data = data
    else:
        all_data["benchmarks"].extend(data["benchmarks"])

out_dir = workspace_dir / "benchmarks"
out_dir.mkdir(parents=True, exist_ok=True)
(out_dir / "tesseract-benchmark_result.json").write_text(json.dumps(all_data, indent=4))
